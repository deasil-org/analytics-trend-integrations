{
  "name": "@analyticstrend/extension",
  "version": "0.6.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs"
  },
  "dependencies": {
    "@analyticstrend/event-schema": "workspace:*",
    "@analyticstrend/sdk-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "description": "AnalyticsTrend SDK for Chromium and Firefox extensions. Manifest V3 safe: no remote code.",
  "keywords": [
    "analytics",
    "product-analytics",
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "manifest-v3",
    "analytique",
    "analyse produit",
    "extension de navigateur",
    "analítica",
    "analítica de producto",
    "extensión de navegador",
    "análise",
    "análise de produto",
    "extensão de navegador",
    "Produktanalyse",
    "Browsererweiterung"
  ],
  "license": "MIT",
  "homepage": "https://analyticstrend.com",
  "bugs": "https://github.com/deasil-org/analytics-trend-integrations/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deasil-org/analytics-trend-integrations.git",
    "directory": "packages/extension"
  },
  "files": [
    "dist",
    "README.md",
    "README.fr.md",
    "README.es.md",
    "README.pt-BR.md",
    "README.de.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
