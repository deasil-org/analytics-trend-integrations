{
  "name": "my-extension",
  "description": "A browser extension measured with AnalyticsTrend.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build && wxt build -b firefox --mv3",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@analyticstrend/extension": "^0.5.0",
    "@analyticstrend/wxt-analytics": "^0.1.0",
    "@wxt-dev/analytics": "0.5.4"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wxt": "^0.21.4"
  }
}
