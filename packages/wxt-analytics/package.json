{
  "name": "@analyticstrend/wxt-analytics",
  "version": "0.1.0",
  "description": "AnalyticsTrend for WXT's analytics module: durable delivery, Firefox consent and uninstall tracking, and nothing about the pages people visit.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs"
  },
  "dependencies": {
    "@analyticstrend/extension": "^0.5.0"
  },
  "peerDependencies": {
    "@wxt-dev/analytics": ">=0.5.4 <0.6.0"
  },
  "devDependencies": {
    "@wxt-dev/analytics": "0.5.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "wxt": "^0.21.4"
  },
  "license": "MIT",
  "homepage": "https://analyticstrend.com/docs/guide/install-wxt",
  "bugs": "https://github.com/deasil-org/analytics-trend-integrations/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deasil-org/analytics-trend-integrations.git",
    "directory": "packages/wxt-analytics"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } }
  }
}
